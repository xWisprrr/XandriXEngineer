# Environment Configuration for XandriX Engineer
# Copy this file to .env and fill in your values

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Provider: openai | anthropic | ollama | groq
LLM_PROVIDER=openai

# Model to use
LLM_MODEL=gpt-4o

# API Key for your LLM provider
LLM_API_KEY=your_api_key_here

# Custom base URL (optional, for Ollama or other OpenAI-compatible APIs)
# LLM_BASE_URL=http://localhost:11434

# ─── Server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Agent Configuration ─────────────────────────────────────────────────────
MAX_ITERATIONS=50
MAX_RETRIES=5
AGENT_TIMEOUT=300

# ─── Optional: Web Search ─────────────────────────────────────────────────────
# WEB_SEARCH_API_KEY=your_serpapi_key
# GITHUB_TOKEN=your_github_token
