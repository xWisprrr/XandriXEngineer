# XandriXEngineer — Environment Configuration
# Copy this file to .env and fill in your values.
# The system works without any API keys using rule-based fallback.

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: openai | anthropic
# Leave both keys empty to use the built-in rule-based fallback (no LLM required)
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4o

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ─── Workspace ────────────────────────────────────────────────────────────────
# Directory where the agent writes generated project files
WORKSPACE_DIR=./workspace

# ─── Execution limits ─────────────────────────────────────────────────────────
MAX_RETRIES=3
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=300

# ─── Memory / Vector Store ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
